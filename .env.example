# AlumniConnect Environment Variables (Placeholders Only)
# See docs/PRODUCTION_ENVIRONMENT.md for the complete authoritative contract.

# ── Runtime & Network ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
TRUST_PROXY=false

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/alumniconnect

# ── Cryptographic Secrets (min 16 chars; generate 64+ char CSPRNG in prod) ───
JWT_ACCESS_SECRET=replace-with-secure-random-secret-at-least-16-chars
JWT_REFRESH_SECRET=replace-with-distinct-secure-secret-at-least-16-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_HASH_SECRET=replace-with-dedicated-otp-hmac-secret-at-least-32-chars

# ── URLs & Domains ───────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Institutional Verification ───────────────────────────────────────────────
COLLEGE_EMAIL_DOMAINS=college.edu,university.edu
STUDENT_REQUIRES_ADMIN_APPROVAL=false

# ── Transactional Email (Resend SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=
REQUIRE_PROD_EMAIL=false

# ── File Storage ─────────────────────────────────────────────────────────────
FILE_STORAGE_DRIVER=local

# ── Administrative Bootstrap (Seed Only) ─────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_PROD_SEED=false
