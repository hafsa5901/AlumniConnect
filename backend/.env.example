# AlumniConnect Backend Environment Variables (Unambiguous Placeholders Only)
# See docs/DEPLOYMENT_RUNBOOK.md and docs/PRODUCTION_ENVIRONMENT.md for full details.

# ── Runtime & Network ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
TRUST_PROXY=1

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<DB_USERNAME>:<DB_PASSWORD>@<CLUSTER_HOST>/alumniconnect?retryWrites=true&w=majority&appName=AlumniConnect

# ── Cryptographic Secrets (Generate 64+ char CSPRNG in production) ───────────
JWT_ACCESS_SECRET=<YOUR_JWT_ACCESS_SECRET_MIN_32_CHARS>
JWT_REFRESH_SECRET=<YOUR_JWT_REFRESH_SECRET_MIN_32_CHARS>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_HASH_SECRET=<YOUR_OTP_HMAC_SECRET_MIN_32_CHARS>

# ── URLs & Domains ───────────────────────────────────────────────────────────
APP_BASE_URL=https://app.example.com
CLIENT_URL=https://app.example.com

# ── Institutional Verification ───────────────────────────────────────────────
STUDENT_EMAIL_DOMAIN=gndecb.ac.in
COLLEGE_EMAIL_DOMAINS=gndecb.ac.in
STUDENT_REQUIRES_ADMIN_APPROVAL=false

# ── Transactional Email (Gmail REST API over HTTPS / OAuth2) ──────────────────
# The Gmail API delivers over HTTPS (port 443), avoiding Render port blocks (25, 465, 587).
GMAIL_OAUTH_CLIENT_ID=<YOUR_GMAIL_OAUTH_CLIENT_ID>
GMAIL_OAUTH_CLIENT_SECRET=<YOUR_GMAIL_OAUTH_CLIENT_SECRET>
GMAIL_OAUTH_REFRESH_TOKEN=<YOUR_GMAIL_OAUTH_REFRESH_TOKEN>
EMAIL_FROM=<YOUR_AUTHENTICATED_GMAIL_ADDRESS>
REQUIRE_PROD_EMAIL=true

# Optional SMTP fallback (e.g. Resend / Custom SMTP):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=2465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=<YOUR_RESEND_API_KEY>

# ── File Storage ─────────────────────────────────────────────────────────────
FILE_STORAGE_DRIVER=local

# ── Administrative Bootstrap (Seed Only) ─────────────────────────────────────
ADMIN_EMAIL=<YOUR_INITIAL_ADMIN_EMAIL>
ADMIN_PASSWORD=<YOUR_INITIAL_ADMIN_PASSWORD>
ALLOW_PROD_SEED=false
